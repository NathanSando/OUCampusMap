# Copy to .env. EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
# Leave the Supabase values blank to run in offline demo mode with the bundled seed data.

# Local: printed by `npx supabase start` (use your computer's LAN IP, not 127.0.0.1, on a phone)
EXPO_PUBLIC_SUPABASE_URL=
# The anon/publishable key. NEVER the service role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public pk.* token, URL-restricted. Never an sk.* secret token.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
# The Node API's origin, e.g. http://192.168.1.20:3000 (the app appends /api)
EXPO_PUBLIC_API_BASE_URL=
